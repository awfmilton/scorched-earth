{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/hud/**",
              "components/match/**",
              "ui_kits/aethercastle/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Uncial Antiqua|Cinzel|Spectral|Share Tech Mono))/i]",
        "message": "Font not provided by the design system. Available: Uncial Antiqua, Cinzel, Spectral, Share Tech Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|tier|solid|pill|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, tier, solid, pill, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brass|magenta|cyan|violet|acid|blood|stone)$/]",
        "message": "<Badge> tone must be one of 'brass' | 'magenta' | 'cyan' | 'violet' | 'acid' | 'blood' | 'stone'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|block|disabled|icon|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, block, disabled, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|gild|plate|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'gild' | 'plate' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HudReadout'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|tone|size|emphasis|style|key|ref|className|style|children)$/]",
        "message": "<HudReadout> doesn't accept that prop. Declared props: label, value, unit, tone, size, emphasis, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HudReadout'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cyan|magenta|brass|acid|blood)$/]",
        "message": "<HudReadout> tone must be one of 'cyan' | 'magenta' | 'brass' | 'acid' | 'blood'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HudReadout'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<HudReadout> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HudPlayer'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|color|hp|shield|shieldMax|angle|power|cash|key|ref|className|style|children)$/]",
        "message": "<HudPlayer> doesn't accept that prop. Declared props: name, color, hp, shield, shieldMax, angle, power, cash."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|glyph|variant|size|active|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: label, glyph, variant, size, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:plate|primary|secondary)$/]",
        "message": "<IconButton> variant must be one of 'plate' | 'primary' | 'secondary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:sprite|src|size|tier|framed|glow|label|fit|style|key|ref|className|style|children)$/]",
        "message": "<IconTile> doesn't accept that prop. Declared props: sprite, src, size, tier, framed, glow, label, fit, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconTile'] > JSXAttribute[name.name='glow'] > Literal[value!=/^(?:magenta|cyan|violet)$/]",
        "message": "<IconTile> glow must be one of 'magenta' | 'cyan' | 'violet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconTile'] > JSXAttribute[name.name='fit'] > Literal[value!=/^(?:cover|contain)$/]",
        "message": "<IconTile> fit must be one of 'cover' | 'contain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|invalid|mono|code|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, invalid, mono, code."
      },
      {
        "selector": "JSXOpeningElement[name.name='LobbySlot'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|name|color|chassis|chassisSprite|kind|host|ready|you|onInvite|style|key|ref|className|style|children)$/]",
        "message": "<LobbySlot> doesn't accept that prop. Declared props: index, name, color, chassis, chassisSprite, kind, host, ready, you, onInvite, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LobbySlot'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:human|ai|empty)$/]",
        "message": "<LobbySlot> kind must be one of 'human' | 'ai' | 'empty'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|kicker|surface|width|onClose|footer|children|style|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, title, kicker, surface, width, onClose, footer, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:plate|parchment)$/]",
        "message": "<Modal> surface must be one of 'plate' | 'parchment'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|kicker|actions|surface|accent|pad|children|style|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: title, kicker, actions, surface, accent, pad, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:plate|parchment)$/]",
        "message": "<Panel> surface must be one of 'plate' | 'parchment'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:brass|magenta|cyan|violet)$/]",
        "message": "<Panel> accent must be one of 'brass' | 'magenta' | 'cyan' | 'violet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadioGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|name|options|value|onChange|inline|style|key|ref|className|style|children)$/]",
        "message": "<RadioGroup> doesn't accept that prop. Declared props: label, name, options, value, onChange, inline, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TurnBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:player|color|subtitle|timer|phase|style|key|ref|className|style|children)$/]",
        "message": "<TurnBanner> doesn't accept that prop. Declared props: player, color, subtitle, timer, phase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TurnBanner'] > JSXAttribute[name.name='phase'] > Literal[value!=/^(?:turn|intermission|round|standings)$/]",
        "message": "<TurnBanner> phase must be one of 'turn' | 'intermission' | 'round' | 'standings'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WeaponCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|sprite|tier|family|cost|packSize|owned|blast|damage|description|affordable|onBuy|selected|style|key|ref|className|style|children)$/]",
        "message": "<WeaponCard> doesn't accept that prop. Declared props: name, sprite, tier, family, cost, packSize, owned, blast, damage, description, affordable, onBuy, selected, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectableWeapon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|sprite|ammo|tier|key|ref|className|style|children)$/]",
        "message": "<SelectableWeapon> doesn't accept that prop. Declared props: name, sprite, ammo, tier."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
